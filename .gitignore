# Carpetas generadas por CMake, Xcode, Visual Studio o Make.
/build/
/build-*/
/cmake-build-*/
/out/
/.vs/
/.vscode/
/.idea/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
*.xcodeproj/
*.xcworkspace/
*.xcuserdata/
*.xcuserstate
*.dSYM/

# Ejecutables y archivos intermedios. El código se compila en cada plataforma.
*.exe
*.o
*.obj
*.a
*.pdb
*.ilk
*.dll
*.lib
*.exp
*.so
*.dylib

# Registros y archivos temporales de ejecución.
registro.txt
*.log
*.tmp

# En doc/ se versionan las fuentes, imágenes y PDF finales; sólo se excluyen
# los auxiliares regenerables de LaTeX.
/doc/**/*.aux
/doc/**/*.fdb_latexmk
/doc/**/*.fls
/doc/**/*.out
/doc/**/*.synctex.gz
/doc/**/*.toc

# Archivos locales del sistema y de edición.
.DS_Store
Thumbs.db
Desktop.ini
core
core.*
*~
*.swp
*.bak
*.blend1
*.blend2
__pycache__/
*.pyc
